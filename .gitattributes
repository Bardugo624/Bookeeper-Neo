# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts MUST keep LF endings even when committed from Windows,
# otherwise they fail on Linux with "bad interpreter: /usr/bin/env^M".
*.sh        text eol=lf
*.bash      text eol=lf

# Server-side files always LF.
*.go        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
Caddyfile   text eol=lf
Dockerfile  text eol=lf
.env*       text eol=lf
