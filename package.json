{
  "name": "bookeeper-neo-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:mobile": "npm run build --workspace=apps/mobile",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "test": "npm run test --if-present --workspace=packages --workspace=apps",
    "typecheck": "npm run typecheck --if-present --workspace=packages --workspace=apps",
    "bk": "node scripts/bk.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "build:2": "npm run build --if-present --workspace=packages --workspace=apps"
  }
}
