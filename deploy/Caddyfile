# Bookeeper Neo — Caddy frontend (Hetzner public + mTLS)
#
# Single listener:
#   :443 — public mTLS-required API. Caddy obtains a Let's Encrypt cert
#          for SERVER_HOST via HTTP-01 (port 80 must be reachable from the
#          internet for issuance/renewal), and verifies client certs
#          against the trust pool at /certs/trusted_clients.pem maintained
#          by bookeeper-server.
#
# The bootstrap surface (pairing/setup) is NOT served here — it is only
# reachable via Tailscale Serve on the tailnet. See compose.

{
	# Bind admin API to all interfaces on the internal Docker bridge.
	# The compose file does NOT publish 2019, so it is unreachable from
	# outside the `bookeeper` network.
	admin 0.0.0.0:2019
	email {$ACME_EMAIL}
}

# HTTP → HTTPS redirect + ACME challenge handling.
:80 {
	redir https://{host}{uri} permanent
}

# ---------------- AUTHENTICATED PUBLIC SURFACE (mTLS) ----------------
{$SERVER_HOST}:443 {
	# Public TLS cert from Let's Encrypt for the hostname; client_auth
	# enforces mTLS using the per-tenant CA bundle.
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /certs/trusted_clients.pem
			}
		}
	}

	# Forward the verified leaf cert to the Go backend so it can resolve
	# device → tenant/user. URL-encoded PEM in X-Client-Cert.
	reverse_proxy bookeeper-server:7842 {
		header_up X-Client-Cert {http.request.tls.client.certificate_pem}
		header_up X-Forwarded-For {remote_host}
	}

	encode gzip

	# Reasonable security headers for an authenticated API.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
