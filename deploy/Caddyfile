# Bookeeper Neo — Caddy frontend (Hetzner public + mTLS + mobile PWA)
#
# Single :443 listener, TWO logical surfaces routed by URL path:
#
#   1. mTLS-required surface — the desktop/authenticated API.
#      Paths: /api/v1/*  (everything except the public surface below).
#      Caddy still terminates TLS and verifies client certs against the
#      per-tenant trust pool maintained by bookeeper-server.
#
#   2. Public (no mTLS) surface — mobile PWA assets + pairing redemption.
#      Paths: /m/*, /pairing/*, /healthz.
#      Browsers cannot present a client cert from JavaScript, so the
#      mobile companion lives here. Pairing is one-shot tokens (10min TTL)
#      so the lack of mTLS is acceptable for that single endpoint.
#
# Why client_auth = request (and not require_and_verify):
#   `require_and_verify` rejects ANY request without a client cert at the
#   TLS handshake — even GET /m/index.html. We need the same hostname to
#   accept both authenticated and anonymous traffic, so we set the TLS
#   handshake to *request* the cert (clients may or may not present one).
#   Caddy's trust_pool keeps the chain check, so when a client *does*
#   present a cert it MUST be from a known tenant CA — invalid certs are
#   still rejected at the handshake. A handler-level guard then rejects
#   any /api/v1/* request that arrived without a cert.

{
	admin 0.0.0.0:2019
	email {$ACME_EMAIL}
}

# HTTP → HTTPS redirect + ACME challenge handling.
:80 {
	redir https://{host}{uri} permanent
}

{$SERVER_HOST}:443 {
	# Public TLS cert from Let's Encrypt for the hostname.
	tls {
		client_auth {
			mode request
			trust_pool file {
				pem_file /certs/trusted_clients.pem
			}
		}
	}

	encode gzip

	# Reasonable security headers for the whole site.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# ----- Public surface: mobile PWA + pairing redemption + health -----
	# These paths bypass mTLS enforcement. Routed to bookeeper-server's
	# bootstrap listener (port 7843).
	#
	# /.well-known/* serves AASA (no extension, application/json) and
	# assetlinks.json for iOS/Android deep linking into the installed PWA.
	@public path /m /m/* /pairing /pairing/* /healthz /.well-known/*
	handle @public {
		reverse_proxy bookeeper-server:7843
	}

	# ----- Authenticated surface: everything else (mTLS required) -----
	# Reject any request that didn't present a client cert during TLS.
	handle {
		@nocert vars {http.request.tls.client.certificate_der_base64} ""
		respond @nocert "client certificate required" 401 {
			close
		}

		reverse_proxy bookeeper-server:7842 {
			header_up X-Client-Cert {http.request.tls.client.certificate_der_base64}
		}
	}
}

# ----------------------------------------------------------------------------
# Mobile public surface — separate hostname, NO client_auth.
#
# Perche' un sottodominio dedicato:
#   Sullo stesso hostname, attivare `client_auth` (anche solo `mode request`)
#   provoca su Android Chrome `SSL_CLIENT_AUTH_CERT_NEEDED` quando il KeyChain
#   del telefono non ha certificati validi: Caddy invia comunque il
#   `CertificateRequest` con la lista CA del trust_pool, e il browser non
#   riesce a completare la handshake "anonima". Spostando le rotte pubbliche
#   (PWA + pairing) su un hostname separato evitiamo qualsiasi richiesta di
#   certificato a livello TLS — nessun prompt, nessun errore.
#
# DEPLOY (richiede una-tantum):
#   1) DNS A record: m.{$SERVER_HOST} -> stesso IP del server.
#   2) Reverse proxy esterno: aggiungere passthrough SNI per
#      m.{$SERVER_HOST} verso 127.0.0.1:{PUBLIC_HTTPS_PORT}.
#   3) PUBLIC_BASE_URL nell'.env del server -> https://m.{$SERVER_HOST}
# ----------------------------------------------------------------------------
m.{$SERVER_HOST}:443 {
	# Niente blocco `tls`: Caddy emette/rinnova automaticamente il
	# certificato Let's Encrypt per questo hostname. Soprattutto, niente
	# `client_auth`: il TLS handshake non chiede certificati al client,
	# evitando l'errore SSL_CLIENT_AUTH_CERT_NEEDED su Android Chrome.

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Tutto va al bootstrap listener della Go server. La logica autorizzativa
	# (token one-shot, redeem) e' a livello applicativo.
	reverse_proxy bookeeper-server:7843
}
