# ============================================================================
# Bookeeper Neo — TEMPLATE per deploy/.env.publish
# ============================================================================
# Copia questo file in deploy/.env.publish e compila i valori.
# Il vero file (.env.publish) NON deve mai essere committato (gitignored).
#
# Usato da: deploy/scripts/publish-desktop.ps1
# ============================================================================

# Cloudflare R2 — bucket pubblico per binari + manifest auto-updater
R2_ACCESS_KEY_ID=__INSERISCI_ACCESS_KEY__
R2_SECRET_ACCESS_KEY=__INSERISCI_SECRET_KEY__

# Endpoint S3-compatible
R2_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com

# Nome bucket
R2_BUCKET=bookeeper-releases

# URL pubblico base (Public R2.dev Bucket URL oppure custom domain)
R2_PUBLIC_BASE=https://pub-__BUCKET_PUBLIC_ID__.r2.dev
