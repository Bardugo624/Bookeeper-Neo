# Bookeeper Neo deployment env — copy to `.env` and fill in.
# DO NOT COMMIT the real .env file (it is in .gitignore).
#
# This file is committed; it must contain ONLY placeholders, never real
# secrets. If you accidentally commit a real TS_AUTHKEY/RESTIC_PASSWORD
# here, REVOKE it immediately on the issuing platform.

# ============ Public surface (Hetzner CPX32) ============
# DNS A record: bookeeper.albacremisi.org → 46.224.218.228 (must be set
# before first `docker compose up`, otherwise ACME issuance fails).
SERVER_HOST=bookeeper.albacremisi.org
ACME_EMAIL=admin@albacremisi.org
SERVICE_NAME=Bookeeper
TZ=Europe/Rome

# ============ Host binding (ISOLATION from other Docker stacks) ============
# Where to bind Bookeeper's public ports on the Hetzner host. Choose ONE:
#
#   - 172.17.0.1  ➜ bind to the Docker bridge gateway (DEPLOYED CHOICE
#                   on alba-prod-1). NOT reachable from Internet, but
#                   reachable from any container. The fronting reverse
#                   proxy (alba-caddy) must be attached to the
#                   `bookeeper-neo-net` external network and proxy
#                   SNI=bookeeper.* to `bookeeper-neo-caddy:443` via
#                   caddy-l4. See deploy/hetzner/SETUP.md.
#
#   - 127.0.0.1   ➜ bind to loopback only; works only if the fronting
#                   reverse proxy is on the host (not in a container).
#
#   - <floating-IP> ➜ bind to a secondary public IP attached to the VM.
#                   Standalone listener; no interaction with the existing
#                   stack. Get one from Hetzner panel → Floating IPs.
#
#   - 0.0.0.0     ➜ ONLY if no other process listens on PUBLIC_HTTPS_PORT
#                   / ACME_HTTP_PORT on this host. Use with non-standard
#                   ports (e.g. 8443) to be safe.
HOST_BIND_IP=172.17.0.1

# Public-facing ports. Set to 443/80 only if HOST_BIND_IP is dedicated
# (loopback or floating IP). Otherwise pick free high ports.
PUBLIC_HTTPS_PORT=8443
ACME_HTTP_PORT=8080

# Docker bridge subnet for Bookeeper's internal network. Change ONLY if
# 172.31.7.0/24 collides with another network on this host.
# Check with: docker network inspect $(docker network ls -q) | grep Subnet
BOOKEEPER_SUBNET=172.31.7.0/24

# ============ Tailscale (bootstrap/pairing surface) ============
# Generate at: https://login.tailscale.com/admin/settings/keys
# Settings: Reusable + Pre-approved + Tags: tag:bookeeper + Expiry 90d.
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_HOSTNAME=bookeeper
# Your tailnet name (Admin → DNS in Tailscale console). e.g. tail1234.ts.net
TAILNET=tail1234.ts.net

# ============ Backup (OPTIONAL — primary backups are Hetzner snapshots) ============
BACKUP_RESTIC_REPOSITORY=
BACKUP_RESTIC_PASSWORD=
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# BACKUP_B2_ACCOUNT_ID=
# BACKUP_B2_ACCOUNT_KEY=
