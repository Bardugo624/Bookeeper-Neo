# The Bookeeper homepage. Installed as /etc/caddy/neokeeper-site.caddy by apps/site/deploy/install.sh.
www.neokeeper.dev {
	encode zstd gzip
	root * /srv/neokeeper-site

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@modules path *.mjs
	header @modules Content-Type "text/javascript; charset=utf-8"
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	header /shots/* Cache-Control "public, max-age=86400"
	@pages path / /en/ *.html *.css *.js *.mjs
	header @pages Cache-Control "no-cache"

	# Only the stable updater manifest, read-only: the page reads the release notes from it.
	handle /updates/stable/latest.json {
		root * /opt/bookeeper
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		file_server
	}
}

neokeeper.dev {
	redir https://www.neokeeper.dev{uri} permanent
}
